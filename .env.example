# Carregue explicitamente: set -a; source .env; set +a
# Execute git lfs pull antes de ativar o ensemble.
# Se a porta 5000 estiver ocupada (comum no macOS), use PORT=5001.
MODEL_BACKEND=ensemble
ENSEMBLE_MANIFEST=models/mdeberta-ensemble/manifest.json
TRANSFORMER_DEVICE=auto
APP_HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
TOKENIZERS_PARALLELISM=false
# Explicação local da probabilidade final por remoção de frases.
XAI_ENABLED=true
# Até 16; o padrão 8 limita o custo adicional (lotes de 2 no ensemble).
XAI_MAX_EVALUATIONS=8
